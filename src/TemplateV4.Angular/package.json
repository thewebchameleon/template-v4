{
  "name": "templatev4-web",
  "version": "0.1.0",
  "scripts": {
    "prestart": "node ../../tools/discover-business-modules.mjs",
    "prebuild": "node ../../tools/discover-business-modules.mjs",
    "prewatch": "node ../../tools/discover-business-modules.mjs",
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0 --port 4200 --ssl --proxy-config proxy.conf.json --ssl-cert ../../.local/web.pem --ssl-key ../../.local/web.key",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "playwright test",
    "lint": "ng lint",
    "format": "prettier --write src libs e2e *.json *.js *.ts",
    "format:check": "prettier --check src libs e2e *.json *.js *.ts",
    "generate:api": "node generate-api.mjs",
    "build:library": "node ../../tools/build-frontend-package.mjs"
  },
  "private": true,
  "packageManager": "npm@12.0.2",
  "dependencies": {
    "@angular/cdk": "22.1.6",
    "@angular/common": "22.1.6",
    "@angular/compiler": "22.1.6",
    "@angular/core": "22.1.6",
    "@angular/forms": "22.1.6",
    "@angular/platform-browser": "22.1.6",
    "@angular/router": "22.1.6",
    "@foleyjs/core": "2.9.0",
    "@microsoft/signalr": "10.0.11",
    "@ng-icons/core": "36.0.0",
    "@ng-icons/lucide": "36.0.0",
    "@ng-icons/phosphor-icons": "36.0.0",
    "@spartan-ng/brain": "1.4.1",
    "@tanstack/angular-table": "9.2.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "ngx-scrollbar": "19.1.5",
    "qrcode": "1.5.4",
    "rxjs": "7.8.2",
    "tailwind-merge": "3.7.0",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.1.8",
    "@angular/cli": "22.1.8",
    "@angular/compiler-cli": "22.1.6",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@spartan-ng/cli": "1.4.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/qrcode": "1.5.6",
    "ajv": "8.20.0",
    "angular-eslint": "22.5.0",
    "eslint": "10.10.0",
    "ng-openapi-gen": "1.0.5",
    "ng-packagr": "22.1.1",
    "prettier": "3.9.6",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  },
  "overrides": {
    "smol-toml": "1.8.0",
    "axios": "1.20.0",
    "adm-zip": "0.6.1",
    "qs": "6.16.0",
    "nx": "22.7.12",
    "uuid": "11.1.1"
  },
  "engines": {
    "node": "24.21.0",
    "npm": "12.0.2"
  }
}
