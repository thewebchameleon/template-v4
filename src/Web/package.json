{
  "name": "templatev4-web",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0 --port 4200 --ssl --proxy-config proxy.conf.json --ssl-cert ../../.local/web.pem --ssl-key ../../.local/web.key",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "playwright test",
    "lint": "ng lint",
    "format": "prettier --write src libs e2e *.json *.js *.ts",
    "format:check": "prettier --check src libs e2e *.json *.js *.ts",
    "generate:api": "node generate-api.mjs"
  },
  "private": true,
  "packageManager": "npm@11.6.4",
  "dependencies": {
    "@angular/cdk": "22.1.5",
    "@angular/common": "22.1.5",
    "@angular/compiler": "22.1.5",
    "@angular/core": "22.1.5",
    "@angular/forms": "22.1.5",
    "@angular/platform-browser": "22.1.5",
    "@angular/router": "22.1.5",
    "@ng-icons/core": "35.1.0",
    "@ng-icons/lucide": "33.4.0",
    "@spartan-ng/brain": "1.4.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "rxjs": "7.8.2",
    "tailwind-merge": "3.6.0",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.1.7",
    "@angular/cli": "22.1.7",
    "@angular/compiler-cli": "22.1.5",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@spartan-ng/cli": "1.4.1",
    "@tailwindcss/postcss": "4.3.3",
    "ajv": "8.20.0",
    "angular-eslint": "22.2.0",
    "eslint": "10.10.0",
    "ng-openapi-gen": "1.0.5",
    "prettier": "3.9.6",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0"
  },
  "engines": {
    "node": "24.18.0",
    "npm": "11.6.4"
  }
}
