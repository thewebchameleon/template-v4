<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <EmbeddedResource Include="../../modules/catalog.json" LogicalName="TemplateV4.Modules.catalog.json" />
    <EmbeddedResource Include="../../modules/presets/*.json" LogicalName="TemplateV4.Modules.%(Filename).json" />
    <Content Include="EmailTemplates/*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="Persistence/Migrations/quartz-3.20.1.sql" />
    <EmbeddedResource Include="Persistence/Migrations/quartz-4.0.1-upgrade.sql" />

    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../TemplateV4.Application/TemplateV4.Application.csproj" />

    <PackageReference Include="MailKit" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="PDFsharp" />
    <EmbeddedResource Include="Invoicing/Fonts/*.ttf" />
    <None Include="Invoicing/Fonts/LICENSE.txt" Pack="true" PackagePath="licenses/NotoSans.txt" />
    <PackageReference Include="AWSSDK.S3" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>
<PropertyGroup><IsPackable>true</IsPackable><Version>0.2.0</Version><Description>TemplateV4 reusable foundation Infrastructure package.</Description></PropertyGroup></Project>
