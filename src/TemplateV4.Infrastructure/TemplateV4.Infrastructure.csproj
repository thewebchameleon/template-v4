    <EmbeddedResource Include="../../modules/presets/*.json" LogicalName="TemplateV4.Modules.%(Filename).json" />
    <Content Include="EmailTemplates/*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="Persistence/Migrations/quartz-3.20.1.sql" />
