{
  "Localisation": {
    "DefaultCulture": "en-ZA",
    "SupportedCultures": [
      "en-ZA",
      "af-ZA"
    ]
  },
  "Features": {
    "maintenance": {
      "Enabled": false,
      "Environments": {
        "Development": true
      }
    },
    "my-files": {
      "Enabled": true
    }
  },
  "Updates": {
    "FeedUrl": "https://releases.example.com",
    "Token": "replace-with-release-feed-token"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  }
}
