    "@angular/core": "22.1.6",
    "@angular/forms": "22.1.6",
    "@angular/platform-browser": "22.1.6",
    "@angular/platform-server": "22.1.6",
    "@angular/router": "22.1.6",
    "@angular/ssr": "22.1.8",
    "express": "5.1.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.1.8",
    "@angular/cli": "22.1.8",
    "@angular/compiler-cli": "22.1.6",
    "@types/express": "5.0.3",
    "@types/node": "24.10.1",
    "typescript": "6.0.3",
    "prettier": "3.9.6"
  },
  "packageManager": "npm@12.0.2",
