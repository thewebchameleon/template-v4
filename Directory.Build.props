<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <_ClientModuleSelection Condition="Exists('$(MSBuildThisFileDirectory)business-modules.enabled')">$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)business-modules.enabled').Trim())</_ClientModuleSelection>
    <NuGetLockFilePath Condition="'$(_ClientModuleSelection)' != '' And ('$(MSBuildProjectName)' == 'TemplateV4.ApiService' Or '$(MSBuildProjectName)' == 'TemplateV4.BackgroundWorker' Or '$(MSBuildProjectName)' == 'TemplateV4.DatabaseMigrator' Or '$(MSBuildProjectName)' == 'TemplateV4.AppHost' Or '$(MSBuildProjectName)' == 'TemplateV4.Application.Tests')">$(MSBuildThisFileDirectory).local/client-locks/$(MSBuildProjectName).packages.lock.json</NuGetLockFilePath>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
