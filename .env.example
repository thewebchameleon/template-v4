# EasyPanel: enable Create .env file. Set these before the first deployment.
# The release branch pins images; do not add a floating image tag here.
PUBLIC_URL=https://app.example.com
JWT_KEY_ID=initial-signing-key
UPDATES_ENABLED=false
UPDATES_FEED_URL=
SECRETS_DIR=/etc/templatev4/example/secrets
S3_ENDPOINT=https://objects.example.com
S3_BUCKET=templatev4
S3_REGION=us-east-1
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM=noreply@example.com
# Choose a different unused subnet and matching Web IP for each deployment.
COMPOSE_SUBNET=172.30.0.0/24
WEB_PROXY_IP=172.30.0.10
