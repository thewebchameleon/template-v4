{
  "$schema": "./framework.schema.json",
  "schemaVersion": "1.0.0",
  "frameworkVersion": "0.1.0",
  "templateVersion": "0.1.0",
  "scaffoldingVersion": "0.1.0",
  "name": "templatev4",
  "toolchains": {
    "dotnet": "10.0.401",
    "node": "24.19.0",
    "npm": "11.19.1",
    "docmd": "0.9.5",
    "angular": "22.1.5",
    "spartan": "1.4.1"
  },
  "modules": [
    "identity",
    "cqrs",
    "postgresql",
    "outbox",
    "quartz",
    "email",
    "localisation",
    "feature-flags",
    "idempotency",
    "storage",
    "mfa",
    "passkeys",
    "operations",
    "audit-history",
    "invitations",
    "notifications",
    "privacy",
    "s3-storage",
    "role-management"
  ],
  "projects": {
    "Domain": "src/TemplateV4.Domain",
    "Application": "src/TemplateV4.Application",
    "Infrastructure": "src/TemplateV4.Infrastructure",
    "API": "src/TemplateV4.ApiService",
    "Worker": "src/TemplateV4.BackgroundWorker",
    "DatabaseMigrator": "src/TemplateV4.DatabaseMigrator",
    "AppHost": "src/TemplateV4.AppHost",
    "ServiceDefaults": "src/TemplateV4.ServiceDefaults",
    "Documentation": "documentation",
    "Web": "src/TemplateV4.Angular",
    "CLI": "tools/framework.mjs",
    "SharedKernel": "src/TemplateV4.SharedKernel",
    "ApplicationTests": "src/TemplateV4.Application.Tests",
    "UiTests": "src/TemplateV4.Ui.Tests",
    "UtilityTests": "src/TemplateV4.Utility.Tests"
  },
  "workloads": {
    "Web": "src/TemplateV4.Angular/Dockerfile",
    "API": "deploy/Dockerfile.dotnet",
    "Worker": "deploy/Dockerfile.dotnet"
  },
  "generatedCode": {
    "src/TemplateV4.Angular/src/app/api": "ng-openapi-gen",
    "src/TemplateV4.Infrastructure/Persistence/Migrations": "dotnet-ef"
  },
  "documentation": "documentation/docs",
  "adrs": "documentation/docs/adr",
  "extensions": {
    "persistence": "EF Core / PostgreSQL",
    "transport": "PostgreSQL outbox / local Worker consumers",
    "email": "SMTP",
    "storage": "S3-compatible / SeaweedFS; local flat-key filesystem fallback",
    "featureFlags": "configuration",
    "apiClient": "ng-openapi-gen",
    "documentation": "DocMD",
    "ui": "Spartan NG",
    "access": "Identity roles with protected built-ins and delegated permissions",
    "personalFiles": "Optional; Features:files:Enabled defaults to false"
  },
  "cultures": {
    "default": "en-ZA",
    "supported": [
      "en-ZA",
      "af-ZA"
    ]
  },
  "packages": {
    "TemplateV4.SharedKernel": "src/TemplateV4.SharedKernel",
    "TemplateV4.ServiceDefaults": "src/TemplateV4.ServiceDefaults"
  }
}
