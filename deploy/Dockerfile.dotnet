FROM --platform=$BUILDPLATFORM node:24.21.0-bookworm-slim AS node
FROM --platform=$BUILDPLATFORM mcr.microsoft.com/dotnet/sdk:10.0.401 AS build
COPY --from=node /usr/local/bin/node /usr/local/bin/node
ARG PROJECT=TemplateV4.ApiService
ARG RELEASE_VERSION
WORKDIR /source
COPY . .
RUN node tools/discover-business-modules.mjs
RUN if [ -f .private-modules/NuGet.Config ]; then dotnet restore src/${PROJECT}/${PROJECT}.csproj --configfile .private-modules/NuGet.Config; else dotnet restore src/${PROJECT}/${PROJECT}.csproj --locked-mode; fi
RUN dotnet publish src/${PROJECT}/${PROJECT}.csproj -c Release --no-restore -o /app /p:UseAppHost=false /p:ReleaseVersion="$RELEASE_VERSION"
RUN cp /app/${PROJECT}.dll /app/entry.dll && cp /app/${PROJECT}.deps.json /app/entry.deps.json && cp /app/${PROJECT}.runtimeconfig.json /app/entry.runtimeconfig.json
RUN install -d -m 700 /keys/ring
FROM mcr.microsoft.com/dotnet/aspnet:10.0.12-noble-chiseled-extra
ARG PROJECT=TemplateV4.ApiService
WORKDIR /app
COPY --from=build /app .
COPY --from=build --chown=1654:1654 /keys /keys
ENV ASPNETCORE_HTTP_PORTS=8080
USER $APP_UID
EXPOSE 8080
ENTRYPOINT ["dotnet", "entry.dll"]
