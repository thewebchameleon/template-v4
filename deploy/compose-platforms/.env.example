# EasyPanel: enable Create .env file. Set these before the first deployment.
# The server builds the selected public revision and provider-assigned compiled modules.
PUBLIC_URL=https://app.example.com
JWT_KEY_ID=initial-signing-key
JWT_KEY_B64=
# Shared by PostgreSQL, Migrator, API, and Worker (postgres login).
POSTGRES_PASSWORD=
UPDATES_ENABLED=false
S3_ENDPOINT=https://storage.example.com
S3_BUCKET=templatev4
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
SEAWEED_CONFIG_JSON=
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_FROM=noreply@localhost
SMTP_USERNAME=
SMTP_PASSWORD=
OTEL_EXPORTER_OTLP_ENDPOINT=
MODULE_DISTRIBUTION_URL=https://modules.example.com
MODULE_APP_ID=
MODULE_APP_TOKEN=
MODULE_ENVIRONMENT_ID=
MODULE_ENVIRONMENT=production
MODULE_BUILD_TOKEN=
# Provider deployment only: comma-separated allowlists and publisher storage access.
MODULE_PUBLISHER_TOKEN_HASH=
MODULE_PUBLISHER_MODULES=
MODULE_ARTIFACT_HOSTS=
MODULE_ARTIFACT_TOKEN=
