  "components": {
    "schemas": {
      "AccessResponse": {
        "required": [
          "accessToken",
          "expiresAt",
          "userId",
          "permissions",
          "culture",
          "mfaConfigured"
        ],
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "culture": {
            "type": "string"
          },
          "mfaConfigured": {
            "type": "boolean"
          },
          "setupRequired": {
            "type": "boolean",
            "default": false
          },
          "challengeId": {
            "type": [
              "null",
              "string"
            ]
          },
          "passkeyRequired": {
            "type": "boolean",
            "default": false
          },
          "mfaMethods": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          },
          "preferredMfaMethod": {
            "type": [
              "null",
              "string"
            ]
          },
          "emailCodeSent": {
            "type": "boolean",
            "default": false
          },
          "emailResendAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        }
      },
      "AdminBootstrapRequest": {
        "required": [
          "token",
          "username",
          "password"
        ],
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "AdminBootstrapStatus": {
        "required": [
          "available"
        ],
        "type": "object",
        "properties": {
          "available": {
            "type": "boolean"
          }
        }
      },
      "ConfirmEmailRequest": {
        "required": [
          "userId",
          "token"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
